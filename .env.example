# Kopier til .env.local for lokal utvikling. På Vercel settes disse automatisk/manuelt (se docs/VERCEL-OPPSETT.md).

# Postgres-tilkobling. Settes automatisk når Neon kobles til prosjektet i Vercel.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/kolapp

# Valgfri. PIN-kode som brukes første gang databasen opprettes. Standard: 1234.
# Endres senere på /admin, ikke her.
INITIAL_PIN=1234

# Valgfri. Adressen QR-kodene peker på. Standard: Vercel sitt produksjonsdomene.
# PUBLIC_BASE_URL=https://ko.readymedia.no

# Valgfri. Hemmelighet for innloggingsøkter (minst 32 tegn).
# Hvis den mangler, lages en automatisk og lagres i databasen.
# SESSION_SECRET=
